{
  "name": "movie-booking-system",
  "version": "1.0.0",
  "description": "Comprehensive Movie Ticket Booking Application covering Experiments 1 to 4",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run backend\" \"npm run frontend\"",
    "start": "node backend/server.js",
    "backend": "npm run start --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "build": "node scripts/build.js",
    "test": "node scripts/test-runner.js"
  },
  "keywords": [
    "react",
    "redux-toolkit",
    "express",
    "jwt",
    "rest-api",
    "movie-booking"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
